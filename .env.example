# ============================================================
# ALWA — Environment variables
# Copy this file to `.env` for local use, or set these as
# environment variables on your deploy platform (Railway/Render).
# NEVER commit the real .env file — it is git-ignored.
# ============================================================

# --- Server ---
PORT=3000

# Set to "true" to run WITHOUT any live APIs (OpenAI / WhatsApp /
# Google are all mocked). Use this to test the flow locally.
MOCK_MODE=false

# --- OpenAI ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Cost-efficient chat model. Change freely.
OPENAI_MODEL=gpt-4.1-mini

# --- WhatsApp Business Cloud API (Meta) ---
# From https://developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# You invent this string yourself, then paste the SAME string into the
# Meta webhook configuration screen ("Verify token").
WHATSAPP_VERIFY_TOKEN=alwa-verify-2026

# --- Google Sheets (logging) ---
# The ID from the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# Service-account credentials (see README §4 for how to create these).
GOOGLE_SERVICE_ACCOUNT_EMAIL=alwa-logger@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, wrapped in quotes:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# --- Supabase (identity, conversations, leads, complaints, surveys) ---
# Create a project at https://supabase.com, run supabase/schema.sql in
# the SQL Editor, then copy these from Project Settings > API.
# OPTIONAL: leave empty and the bot runs in Sheets-only mode (no
# identity check, no complaint records, no leads, no report).
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Use the service_role key (server-side secret), NOT the anon key:
SUPABASE_SERVICE_ROLE_KEY=

# --- Reporting ---
# Any random string; protects GET /report?month=YYYY-MM&secret=...
REPORT_SECRET=

# --- Email alerts via Google Apps Script (REQUIRED channel) ---
# The web-app URL you get after deploying apps-script/Code.gs (README §5).
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Shared secret — set the SAME value in the Apps Script's Script Properties.
APPS_SCRIPT_SECRET=change-me-to-a-long-random-string

# --- Telegram alerts (OPTIONAL — leave empty to disable) ---
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs (get yours from @userinfobot).
TELEGRAM_CHAT_IDS=

# --- CallMeBot WhatsApp alerts (OPTIONAL — leave empty to disable) ---
# NOTE: this is a SEPARATE service from the customer-facing WhatsApp
# number. See https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Format: phone1:apikey1,phone2:apikey2
CALLMEBOT_RECIPIENTS=

# --- Test endpoint ---
# Set to "true" to enable POST /test-message even outside mock mode.
# Leave false in production once you're done testing.
TEST_ENDPOINT_ENABLED=false
